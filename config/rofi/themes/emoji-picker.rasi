#emoji-picker window {
    background-color:            #11111b;
    border-color:                #89b4fa;
    border-radius:               12px;
    width:                       800px;
    height:                      600px;
}

#emoji-picker mainbox {
    children:                    [ "inputbar", "listview" ];
}

#emoji-picker inputbar {
    background-color:            #181825;
    border-radius:               10px 10px 0px 0px;
    padding:                     15px;
    children:                    [ "prompt", "entry" ];
}

#emoji-picker prompt {
    background-color:            #89b4fa;
    text-color:                  #11111b;
    padding:                     8px 15px;
    border-radius:               6px;
}

#emoji-picker entry {
    placeholder:                 "Search emojis...";
    placeholder-color:           #7f849c;
}

#emoji-picker listview {
    columns:                     8;
    lines:                       6;
    spacing:                     12px;
    padding:                     25px;
}

#emoji-picker element {
    border-radius:               10px;
    background-color:            #181825;
    text-color:                  #cdd6f4;
}

#emoji-picker element-icon {
    size:                        56px;
}

#emoji-picker element-text {
    enabled:                     false;
}

#emoji-picker element selected.normal {
    background-color:            #89b4fa;
    text-color:                  #11111b;
}
