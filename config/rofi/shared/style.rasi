/**
 * Inspired by the uploaded bar: Ultra-rounded & Clean
 **/

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               30px;      /* Very round window */
    background-color:            @background;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     25px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/* --- The Search Bar (Pill Shape) --- */
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px 10%;   /* Adds side padding for a centered look */
    padding:                     10px 20px;
    border-radius:               50px;      /* Perfect pill shape */
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    background-color:            transparent;
    text-color:                  inherit;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}

/* --- The List of Apps --- */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     10px;
    background-color:            transparent;
    cursor:                      "default";
}

/* --- Elements (The "Workspaces" look) --- */
element {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px 5px;
    padding:                     12px 20px;
    border-radius:               100px;    /* Makes each result look like the bar's buttons */
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element selected.normal {
    /* To mimic the gradient button in your image: */
    background-color:            @selected; 
    text-color:                  @background;
}

element-icon {
    background-color:            transparent;
    size:                        28px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
