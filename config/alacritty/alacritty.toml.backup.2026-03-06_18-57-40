[window]
padding = { x = 0, y = 0 }
dynamic_padding = true
opacity = 0.85
title = "Alacritty"
class = { instance = "Alacritty", general = "Alacritty" }
decorations = "full"

[general]
ipc_socket = true

[scrolling]
history = 10000
multiplier = 3

[font]
size = 11.0

[font.normal]
family = "monospace"
style = "Regular"

[font.bold]
family = "monospace"
style = "Bold"

[font.offset]
x = 1
y = 1

[cursor]
style = { shape = "underline", blinking = "On" }
unfocused_hollow = true

# GRUVBOX DARK COLORS
[colors.primary]
background = "#1d2021"
foreground = "#ebdbb2"

[colors.cursor]
text = "#1d2021"
cursor = "#0096C7"

[colors.selection]
text = "CellForeground"
background = "#d65d0e"

[colors.normal]
black = "#282828"
red = "#cc241d"
green = "#98971a"
yellow = "#d79921"
blue = "#458588"
magenta = "#b16286"
cyan = "#689d6a"
